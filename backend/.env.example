# Copy to .env for local development. Use unique random secrets outside local development.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/medishield
MONGO_URI=mongodb://127.0.0.1:27017/medishield
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
UPLOAD_DIR=uploads
# Local Tesseract OCR uses English by default and downloads its model on first scan.
TESSERACT_LANGUAGE=eng
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=MediShield <no-reply@your-verified-domain.com>
PASSWORD_RESET_SECRET=replace_with_a_long_random_password_reset_secret
